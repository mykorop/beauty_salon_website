---
import type { GetStaticPaths } from 'astro';
import LegalLayout from '../../layouts/LegalLayout.astro';
import { legalPages, type LegalPage } from '../../content/legal';
import { isPublished, prefixedLocales, type Locale } from '../../i18n';

export const getStaticPaths = (() => prefixedLocales.flatMap((locale) => legalPages.filter((page) => isPublished(locale, page)).map((page) => ({
  params: { locale, page },
  props: { locale, page },
})))) satisfies GetStaticPaths;

interface Props { locale: Locale; page: LegalPage }
const { locale, page } = Astro.props;
---
<LegalLayout locale={locale} page={page} />
