---
// Each weight file declares its Latin and Latin Extended faces with a unicode-range, so the browser
// requests the subsets a page needs together. The single-subset files have no range: the Latin Extended
// face then claims every character and the Latin file is only requested after it arrives, a second font swap.
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/cyrillic-fonts.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import StructuredData from '../components/StructuredData.astro';
import { absolutePageUrl, labels, languageAlternates, languages, locales, pageLocales, type Locale, type Page } from '../i18n';

// A page outside the public map (404) is never canonicalized or indexed.
interface Props { locale: Locale; page?: Page; title: string; description: string }
const { locale, page, title, description } = Astro.props;
const canonical = page ? absolutePageUrl(locale, page) : undefined;
const socialImage = new URL(`/social/bookme-${locale}.png`, Astro.site).href;
const socialImageAlt = labels[locale].socialImageAlt;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page ? (
      <>
        <link rel="canonical" href={canonical} />
        {languageAlternates(page).map(({ language, href }) => (
          <link rel="alternate" hreflang={language} href={href} />
        ))}
      </>
    ) : <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#181a1d" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BookMe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={languages[locale].ogLocale} />
    {(page ? pageLocales(page) : locales).filter((other) => other !== locale).map((other) => (
      <meta property="og:locale:alternate" content={languages[other].ogLocale} />
    ))}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {page && <StructuredData locale={locale} page={page} title={title} description={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels[locale].skip}</a>
    <Navigation locale={locale} page={page} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
  </body>
</html>
