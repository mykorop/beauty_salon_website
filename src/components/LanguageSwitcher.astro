---
import { labels, languages, locales, switchUrl, type Locale, type Page } from '../i18n';
interface Props { locale: Locale; page?: Page }
const { locale, page } = Astro.props;
---
<nav class="languages" aria-label={labels[locale].language}>
  {locales.map((language, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a href={switchUrl(language, page)} lang={language} hreflang={language} aria-label={languages[language].name} aria-current={page && locale === language ? 'page' : undefined}>{language.toUpperCase()}</a>
    </>
  ))}
</nav>
