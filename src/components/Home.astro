---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactForm from './ContactForm.astro';
import DownloadApps from './DownloadApps.astro';
import AppPreview from './AppPreview.astro';
import Faq from './Faq.astro';
import { homeContent } from '../content/home';
import type { Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = homeContent[locale];
---
<SiteLayout locale={locale} page="home" title={text.title} description={text.description}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 id="home-title">{text.heading}</h1>
        <p class="hero-intro">{text.intro}</p>
        <div class="hero-ctas">
          <a href="#clients" class="btn-primary">{text.clientLink}<span aria-hidden="true">↗</span></a>
          <a href="#business" class="btn-secondary">{text.businessLink}</a>
        </div>
        <a class="how-link" href="#how-it-works">{text.howLink}<span aria-hidden="true"> ↓</span></a>
      </div>
      <div class="hero-preview"><AppPreview locale={locale} kind="search" /></div>
    </div>
  </section>

  <section id="how-it-works" class="section section-alt" aria-labelledby="steps-title">
    <div class="section-inner">
      <h2 id="steps-title">{text.stepsTitle}</h2>
      <p class="section-subtitle">{text.stepsIntro}</p>
      <ol class="steps">
        {text.steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">0{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="section-inner">
      <h2 id="features-title">{text.featuresTitle}</h2>
      <p class="section-subtitle">{text.featuresIntro}</p>
      <section id="clients" class="audience client-audience" aria-labelledby="clients-title">
        <div class="audience-intro">
          <p class="eyebrow">{text.client.tag}</p>
          <h3 id="clients-title">{text.client.title}</h3>
          <p>{text.client.intro}</p>
          <a href="#download-client" class="text-link">{text.client.download}<span aria-hidden="true"> ↗</span></a>
        </div>
        <ul class="audience-features">
          {text.client.features.map((feature, index) => (
            <li>
              <span class="feature-number" aria-hidden="true">0{index + 1}</span>
              <div><h4>{feature.title}</h4><p>{feature.body}</p></div>
            </li>
          ))}
        </ul>
      </section>
      <section id="business" class="audience business-audience" aria-labelledby="business-title">
        <div class="audience-intro">
          <p class="eyebrow">{text.business.tag}</p>
          <h3 id="business-title">{text.business.title}</h3>
          <p>{text.business.intro}</p>
          <ul class="business-features">
            {text.business.features.map((feature) => (
              <li><h4>{feature.title}</h4><p>{feature.body}</p></li>
            ))}
          </ul>
          <a href="#download-business" class="text-link">{text.business.download}<span aria-hidden="true"> ↗</span></a>
        </div>
        <AppPreview locale={locale} kind="calendar" />
      </section>
    </div>
  </section>

  <DownloadApps locale={locale} />
  <Faq locale={locale} />

  <section id="contact" class="section section-alt" aria-labelledby="contact-title">
    <div class="section-inner contact-section">
      <h2 id="contact-title">{text.contactTitle}</h2>
      <p class="section-subtitle">{text.contactIntro}</p>
      <ContactForm locale={locale} />
    </div>
  </section>
</SiteLayout>

<style>
  .hero { padding: clamp(3rem, 7vw, 7rem) 2rem; border-bottom: 1px solid var(--border); background: radial-gradient(ellipse at 82% 48%, rgb(223 191 122 / 6%), transparent 55%); }
  .hero-inner { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.25fr 1fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .hero-content { min-width: 0; }
  h1 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: clamp(3rem, 6.5vw, 5.6rem); line-height: 1.04; letter-spacing: -0.025em; margin: 1.5rem 0; text-wrap: balance; }
  .hero-intro { max-width: 34rem; color: var(--text-muted); font-size: 1.05rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-ctas a { justify-content: space-between; }
  .how-link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; min-height: 44px; font-size: 0.85rem; color: var(--text-muted); }
  .hero-preview { min-width: 0; padding: 1.5rem; border: 1px solid rgb(223 191 122 / 25%); border-radius: 12rem 12rem 1.5rem 1.5rem; background: rgb(223 191 122 / 3%); }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; list-style: none; }
  .step { border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .step-number { display: block; font-family: 'Instrument Serif', serif; font-size: 2.5rem; color: var(--accent); margin-bottom: 0.75rem; }
  .step h3 { font-size: 1.05rem; font-weight: 500; margin-bottom: 0.75rem; }
  .step p, .audience p { color: var(--text-muted); font-size: 0.95rem; }
  .audience { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding-block: 3rem; }
  .audience-intro h3 { font-family: 'Instrument Serif', serif; font-size: clamp(2rem, 3.8vw, 3.25rem); font-weight: 400; line-height: 1.12; text-wrap: balance; margin: 1rem 0 1.25rem; }
  .audience .eyebrow { color: var(--accent); font-size: 0.7rem; }
  .audience-features, .business-features { list-style: none; }
  .audience-features li { display: flex; gap: 1.25rem; padding-block: 1.5rem; border-bottom: 1px solid var(--border); }
  .audience-features li:first-child { padding-top: 0; }
  .feature-number { color: var(--accent); font-size: 0.75rem; padding-top: 0.2rem; }
  .audience h4 { font-size: 1rem; font-weight: 500; margin-bottom: 0.5rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; margin-top: 1.5rem; font-size: 0.9rem; }
  .business-audience { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: 5rem; }
  .business-features { margin-top: 1.5rem; }
  .business-features li { margin-top: 1.25rem; padding-left: 1rem; border-left: 1px solid var(--accent); }
  .business-features p { font-size: 0.85rem; }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; max-width: 640px; }
    .hero-content { text-align: center; }
    .hero-intro { margin-inline: auto; }
    .hero-ctas { justify-content: center; }
    .hero-preview { width: 100%; max-width: 470px; margin: 1rem auto 0; }
  }
  @media (max-width: 768px) {
    .steps, .audience { grid-template-columns: 1fr; }
    .audience { gap: 2.5rem; padding-block: 1.5rem; }
    .business-audience { padding-top: 3rem; }
  }
  @media (max-width: 600px) {
    .hero { padding: 3rem 1.25rem; }
    .hero-preview { padding: 0.75rem; }
    .hero-ctas { flex-direction: column; }
    .hero-ctas a { justify-content: center; }
  }
</style>
