---
interface Props { name: 'search' | 'person' | 'calendar' | 'time' | 'pin' | 'chevron' | 'check' | 'back' }
const { name } = Astro.props;
---
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && <><circle cx="10" cy="10" r="6.5" /><path d="m15 15 6 6" /></>}
  {name === 'person' && <><circle cx="12" cy="7" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18m-13 4h1m6 0h1m-8 3h1" /></>}
  {name === 'time' && <><circle cx="12" cy="12" r="9" /><path d="M12 6v6l4 2" /></>}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z" /><circle cx="12" cy="10" r="2" /></>}
  {name === 'chevron' && <path d="m8 9 4-4 4 4m-8 6 4 4 4-4" />}
  {name === 'check' && <path d="m5 12 5 5L20 7" />}
  {name === 'back' && <path d="m11 5-7 7 7 7M4 12h16" />}
</svg>
