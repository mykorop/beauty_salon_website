---
import { homeContent } from '../content/home';
import { pageUrl, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = homeContent[locale].faq;
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="section-inner faq-inner">
    <h2 id="faq-title">{text.title}</h2>
    <p class="section-subtitle">{text.intro}</p>
    {text.items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
    <a class="deletion-link" href={pageUrl(locale, 'delete-account')}>{text.deletionLink}</a>
  </div>
</section>

<style>
  .faq-inner { max-width: 780px; }
  details { border-bottom: 1px solid var(--border); }
  details:first-of-type { border-top: 1px solid var(--border); }
  summary { padding: 1.25rem 0.25rem; cursor: pointer; font-size: 1.05rem; font-weight: 500; }
  summary::marker { color: var(--accent); }
  details[open] summary { color: var(--accent); }
  details p { padding: 0 0.25rem 1.5rem; color: var(--text-muted); }
  .deletion-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1.5rem; }
</style>
