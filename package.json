{
  "name": "bookme-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "build:consent-test": "BOOKME_CONSENT_TEST=1 astro build",
    "test:consent": "npm run build:consent-test && BOOKME_CONSENT_TEST=1 playwright test",
    "test:consent-incomplete": "BOOKME_CONSENT_TEST=incomplete astro build && BOOKME_CONSENT_TEST=incomplete playwright test",
    "test:seo": "npm run build && playwright test tests/seo.spec.ts",
    "test:budgets": "playwright test tests/budgets.spec.ts --project=chromium",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "package:site": "mkdir -p artifacts && COPYFILE_DISABLE=1 tar -czf artifacts/bookme-website.tar.gz -C dist ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@fontsource-variable/noto-serif-display": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "typescript": "5.9.3"
  }
}
